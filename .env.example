# Base de datos local (BD-03). Relativa al directorio desde el que se ejecuta.
DATABASE_PATH=data/qabase.sqlite

# Secreto de sesión (SEG-05). Obligatorio cuando exista el módulo de identidad.
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# El servidor solo escucha en loopback (BE-03, SEG-01).
HOST=127.0.0.1
PORT=3000

# Mesa de Ayuda: la integración real es importación de archivo, sin credenciales.
# Las variables de conexión se definirán en la spec del módulo (ver ADR 0003).
