# Copia este archivo a ~/.qabase/helpdesk.env y ejecuta chmod 600.
HELPDESK_URL=https://mesadeayuda.cajalosandes.pe/pages/UI.php
HELPDESK_USER=tu.usuario
HELPDESK_PASSWORD=tu.clave
HELPDESK_ASSIGNED_TO=Tu Nombre Como Aparece

# Opcionales, solo si el descubrimiento no detecta los campos.
HELPDESK_USERNAME_FIELD=
HELPDESK_PASSWORD_FIELD=
HELPDESK_TICKETS_URL=
HELPDESK_MAX_PAGES=5

# QABase a través del túnel SSH.
QABASE_URL=http://127.0.0.1:3000
# Lee el token en el VPS con: cat data/sync-token
QABASE_SYNC_TOKEN=pega-aqui-el-token
